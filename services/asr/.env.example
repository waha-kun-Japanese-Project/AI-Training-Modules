# ==========================================================
# Service
# ==========================================================

SERVICE_NAME="ASR AI Service"
SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=development


# ==========================================================
# Model
# ==========================================================

MODEL_NAME=mohammedaly22/QwenCleo-ASR
MODEL_DEVICE=auto
MODEL_TRUST_REMOTE_CODE=true


# ==========================================================
# Audio Validation
# ==========================================================

ASR_MAX_UPLOAD_SIZE_MB=25
ASR_SUPPORTED_FORMATS=["wav","mp3","flac","m4a","ogg","webm"]

# ==========================================================
# Storage
# ==========================================================

# Temporary directory for audio files during inference
ASR_UPLOAD_DIR=/tmp/asr_uploads

# ==========================================================
# RabbitMQ
# ==========================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Messages coming from .NET backend
RABBITMQ_REQUESTS_QUEUE=asr.transcription.requests

# Results sent back to .NET backend
RABBITMQ_RESULTS_QUEUE=asr.transcription.results

# One audio per model instance
RABBITMQ_PREFETCH_COUNT=1

# ==========================================================
# API 
# ==========================================================

API_HOST=0.0.0.0
# API_PORT=8000

API_PORT=8001


GRPC_HOST=0.0.0.0
GRPC_PORT=50051